{
  "manifest_version": 3,
  "name": "Simple Media Downloader",
  "version": "0.1.0",
  "description": "Finds direct media links and open HLS streams on the current page.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Media Downloader",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "hls/hls.html",
        "hls/hls.css",
        "hls/modules/*.js",
        "dash/dash.html",
        "dash/dash.css",
        "dash/modules/*.js",
        "shared/*.js",
        "vendor/ffmpeg/*",
        "vendor/fflate/*",
        "playlist-downloader/playlist-downloader.html",
        "playlist-downloader/playlist-downloader.css",
        "playlist-downloader/modules/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/consts.js",
        "content/url-utils.js",
        "content/icons.js",
        "content/tracks.js",
        "content/adapters.js",
        "content/scan.js",
        "content/panels.js",
        "content/bootstrap.js",
        "content/soundcloud-sets.js"
      ],
      "run_at": "document_idle"
    }
  ]
}