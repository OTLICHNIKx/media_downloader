{
  "manifest_version": 3,
  "name": "OTLICHNIK MEDIA DOWNLOADER",
  "version": "0.2.0",
  "description": "Finds open media streams on the current page and helps save files you are allowed to keep.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "OTLICHNIK MEDIA DOWNLOADER",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "hls/hls.html",
        "hls/hls.css",
        "hls/modules/*.js",
        "dash/dash.html",
        "dash/dash.css",
        "dash/modules/*.js",
        "shared/*.js",
        "vendor/ffmpeg/*",
        "vendor/fflate/*",
        "playlist-downloader/playlist-downloader.html",
        "playlist-downloader/playlist-downloader.css",
        "playlist-downloader/modules/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/consts.js",
        "content/url-utils.js",
        "content/icons.js",
        "content/tracks.js",
        "content/adapters.js",
        "content/scan.js",
        "content/panels.js",
        "content/bootstrap.js",
        "content/soundcloud-sets.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "short_name": "Media Downloader",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
